// room script file

function room_AfterFadeIn()
{
   if (player.PreviousRoom == 3)
  {
    player.Say("Non vedo un accidente.");
    player.Say("Meglio tornare indietro.");
    player.ChangeRoom(3, 280,  109);
    player.FaceDirection(eDirectionDown);
    player.Transparency = 0;
  }
  else if (player.PreviousRoom == 4)
    {
    player.Say("E invece no! Porco dio!");
    player.Say("Torno al villaggio");
    player.ChangeRoom(4,  1235,  234);
    player.FaceDirection(eDirectionDown);
    player.Transparency = 0;
    }
}