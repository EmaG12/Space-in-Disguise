// room script file

function room_AfterFadeIn()
{
   if (player.PreviousRoom == 3)
  {
    if (player.HasInventory(iGeoMappa)){
    player.Say("Meglio utilizzare la GeoMappa per arrivare al villaggio.");
    
    player.ChangeRoom(3, 280,  109);
    player.FaceDirection(eDirectionDown);
    player.Transparency = 0;
    }
    else{
    player.Say("Non sono sicuro che questa sia la strada giusta.");
    player.Say("Meglio tornare indietro.");
    player.ChangeRoom(3, 280,  109);
    player.FaceDirection(eDirectionDown);
    player.Transparency = 0;
    }
  }
  else if (player.PreviousRoom == 4)
    {
    player.Say("Mh... in che posto mi trovo, forse dovrei usare la geo-mappa");
    player.Say("Meglio tornare indietro");
    player.ChangeRoom(4,  1235,  234);
    player.FaceDirection(eDirectionDown);
    player.Transparency = 0;
    }
}