// room script file

function room_AfterFadeIn()
{
  mouse.Visible = false;
  //aMusicaTitoli.Play(); // Sostituisci con il nome del tuo file musicale
  StartCutscene(eSkipESCOnly);
  Wait(40); 
  Overlay *testo1 = Overlay.CreateTextual(60, 80, 200, 1, 14, "Grazie per aver giocato a 'Space In Disguise'... l'avventura continuera'!");
  Wait(160); 
  testo1.Remove(); 
  Wait(40); 
  Overlay *testo2 = Overlay.CreateTextual(60, 80, 200, 1, 11, "Una creazione Sloteam:[Di Liso Gabriele[Facilla Nicola[Grieco Emanuele");
  Wait(240); 
  testo2.Remove();
  Wait(40);
  Overlay *testo3 = Overlay.CreateTextual(60, 160, 200, 1, 15, "Premere ESC per uscire.");
  WaitMouseKey(4800); 
  EndCutscene();
}


function room_Load()
{
 
 lblAction.Visible = false;
}

function room_Leave()
{
player.ChangeRoom(0, 0);
}
