 // room script file

function room_AfterFadeIn()
{
    mouse.Visible = false;  
    StartCutscene(eSkipESCOnly);
   
    aAllarme.Play(eAudioPriorityNormal, eRepeat);
   
    cHT.Say("I comandi non rispondono, sto per schiantarmi!");
   
    ShakeScreenBackground(5, 10, 240);
    int i = 0;
    while (i < 6) 
    {
        gAllarme.Visible = true;       
        Wait(15);   
        gAllarme.Visible = false;       
        Wait(10);                      
        i++;
    }
 
    aAllarme.Stop();
    Wait(10);
    aSchianto.Play();
 
    FadeOut(40);
    Wait(400);
    EndCutscene();
 
    player.ChangeRoom(2, 86, 153); 
mouse.Visible = true; 
} 


