 bool frecciaUscitaAttiva = false;
 bool minera_aperta = false;

function on_mouse_click (MouseButton button)

{

  if (button == eMouseLeft)

  {

    // --- CASO 1: Ingresso verso il villaggio (L'enigma del buio) ---

    if (Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hVillaggioCaverna)

    {

      if (player.ActiveInventory == null)

      {

        ClaimEvent(); // Blocca l'apertura della ruota


        // Cammina verso il cunicolo (sostituisci X e Y)

        player.Walk(1248, 213, eBlock, eWalkableAreas); 


        // Va nella stanza buia
        player.FaceDirection(eDirectionRight);
        player.Say("Non sono molto sicuro che questa sia la strada giusta per tornare");

        player.Transparency = 100;

        player.ChangeRoom(5); 

      }

    }

      else if (Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hEntrataOfficina)

      {

        if (player.ActiveInventory == null)

        {

          ClaimEvent(); // Blocca l'apertura della ruota


        //Converte il click in un semplice comando di camminata, 

        // in modo che il personaggio raggiunga l'area/region che innesca il cambio stanza

          Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
          player.FaceDirection(eDirectionLeft);
          player.Walk(825,  254,  eBlock, eWalkableAreas);
          player.ChangeRoom(6, 68,  146, eDirectionRight); 


      }

    }
    else if (Hotspot.GetAtScreenXY(mouse.x,  mouse.y) == hMiniera)
      {
        if (player.ActiveInventory == null)
        {
          ClaimEvent(); // Blocca l'apertura della ruota


        //Converte il click in un semplice comando di camminata, 

        // in modo che il personaggio raggiunga l'area/region che innesca il cambio stanza

          Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
          player.FaceDirection(eDirectionRight);
          if (minera_aperta == true)
          {
          player.Walk(1294, 413,  eBlock, eWalkableAreas);
          player.ChangeRoom(7, 105, 132, eDirectionRight); 
          }
          else
          {
          player.Walk(1294, 413,  eBlock, eWalkableAreas);
          player.Say("E'chiusa, ho bisogno di qualcosa per aprirla");
          }
        }
      }

     }

  }


function Cambio_Cursore()

{

  // --- GUARDIA DI SICUREZZA ---

  // Se il mouse sta puntando su una GUI (Inventario, Menu, ecc.) o il gioco è in pausa

  if (GUI.GetAtScreenXY(mouse.x, mouse.y) != null || IsGamePaused()) 

  {

    frecciaUscitaAttiva = false; // Resettiamo la variabile per sicurezza

    return; // Il comando 'return' blocca la funzione qui. Il codice sottostante non verrà letto!

  }


  // --- IL TUO CODICE NORMALE ---

  // AGS memorizza in automatico l'hotspot che stai puntando (ora lo fa solo se non ci sono GUI di mezzo)

  Hotspot* hSottoMouse = Hotspot.GetAtScreenXY(mouse.x, mouse.y);


  if (hSottoMouse == hVillaggioCaverna) 

  {

    if (frecciaUscitaAttiva == false)

    {

      mouse.SaveCursorUntilItLeaves();

      mouse.UseModeGraphic(eModeExitRight);

      frecciaUscitaAttiva = true;

    }

  }

    else if (hSottoMouse == hEntrataOfficina) 

    { 

      if (frecciaUscitaAttiva == false)

      {

        mouse.SaveCursorUntilItLeaves();

        mouse.UseModeGraphic(eModeExitLeft); 

        frecciaUscitaAttiva = true;

      }
    }
    else if (hSottoMouse == hMiniera && minera_aperta == true)
    {
      if (frecciaUscitaAttiva == false)

      {

        mouse.SaveCursorUntilItLeaves();

        mouse.UseModeGraphic(eModeExitRight); 

        frecciaUscitaAttiva = true;
      }
    }
  // --- RESET GENERALE ---

  else

  {

    frecciaUscitaAttiva = false;

  }

}


function room_RepExec()

{
  Cambio_Cursore();
}


function hVillaggioCaverna_UseInv(Hotspot *theHotspot, CursorMode mode)

{

    if (player.ActiveInventory == iGeoMappa) 

  {

    player.Walk(1248, 213, eBlock, eWalkableAreas);

    player.FaceDirection(eDirectionRight);

    player.Say("Fammi usare questo, non si sa' mai");

    player.ActiveInventory = null;

    mouse.Mode = eModeInteract;

    player.ChangeRoom(3,  280,  109, eDirectionDown); 

  }

  else 

  {

    player.Say("Questo oggetto non mi aiuta a trovare la strada corretta.");

}

}

function room_AfterFadeIn()

{
  cBecca.FaceDirection(eDirectionUp);
  aVillaggioDesertico.Play(eAudioPriorityLow, eRepeat);
  mouse.Mode = eModeInteract;

} 


function room_Unload()
{
aVillaggioDesertico.Stop();
}


function hMiniera_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iChiave)
  {
    if (minera_aperta == false)
    {
      player.Walk(1291, 417, eBlock, eWalkableAreas);
      player.FaceDirection(eDirectionRight);
      player.Say("Vediamo se la chiave funziona...");
      oGate.Visible = false;
      RestoreWalkableArea(2);
      player.LoseInventory(iChiave);
      player.ActiveInventory = null;
      mouse.Mode = eModeInteract;

      minera_aperta = true; 
      Wait(15);
      player.ChangeRoom(7,  105, 132, eDirectionRight); 
    }
    else 
    {
      player.Say("La miniera e' gia' aperta, posso entrarci senza problemi.");
    }
  }
  else
  {
    player.Say("Non posso usarlo per aprire questo passaggio.");
  }
}
function room_Load()
{
  if (minera_aperta == false)
  {
  RemoveWalkableArea(2);
  }
}
