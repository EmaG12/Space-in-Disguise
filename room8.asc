// room script file

function room_Load()
{
aLaboratorio.Play(eAudioPriorityHigh, eRepeat);

}

function room_Unload()
{
aLaboratorio.Stop();
}

bool frecciaUscitaAttiva = false;


function on_mouse_click (MouseButton button)
{
  if (button == eMouseLeft)
  {
    // --- CASO 1: Ingresso verso il villaggio ---
    if (Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hLaboratorioMiniera)
    {
      if (player.ActiveInventory == null)
      {
        ClaimEvent(); // Blocca l'apertura della ruota

        // Cammina verso il cunicolo in modo bloccante
        player.Walk(202, 45, eBlock, eWalkableAreas); 
        player.FaceDirection(eDirectionUp);

        // --- IL NOSTRO CONTROLLO (IL LUCCHETTO) ---
        if( enigmaLaboratorio == false)
        {
          // Il giocatore NON ha ancora risolto l'enigma
          player.Say("Non posso andarmene. Devo prima capire come sbloccare l'accesso.");
          
          // Facciamo fare al pg un piccolo passo indietro per fargli riprendere respiro
          player.Walk(player.x, player.y + 20, eBlock, eWalkableAreas);
          player.FaceDirection(eDirectionUp);
        }
        else 
        {
          // Il giocatore HA risolto l'enigma, lo lasciamo uscire!
          player.ChangeRoom(7, 528, 98, eDirectionDown); 
        }
      }
    }
  }
}

function Cambio_Cursore()

{

  // --- GUARDIA DI SICUREZZA ---

  // Se il mouse sta puntando su una GUI (Inventario, Menu, ecc.) o il gioco è in pausa

  if (GUI.GetAtScreenXY(mouse.x, mouse.y) != null || IsGamePaused()) 

  {

    frecciaUscitaAttiva = false; // Resettiamo la variabile per sicurezza

    return; // Il comando 'return' blocca la funzione qui. Il codice sottostante non verrà letto!

  }


  // --- IL TUO CODICE NORMALE ---

  // AGS memorizza in automatico l'hotspot che stai puntando (ora lo fa solo se non ci sono GUI di mezzo)

  Hotspot* hSottoMouse = Hotspot.GetAtScreenXY(mouse.x, mouse.y);


  if (hSottoMouse == hLaboratorioMiniera) 

  {

    if (frecciaUscitaAttiva == false)

    {

      mouse.SaveCursorUntilItLeaves();

      mouse.UseModeGraphic(eModeExitUp);

      frecciaUscitaAttiva = true;

    }

  //}

      //else if (hSottoMouse == hMinieraLaboratorio) 

      //{ 

        //if (frecciaUscitaAttiva == false)

        //{

          //mouse.SaveCursorUntilItLeaves();

          //mouse.UseModeGraphic(eModeExitUp);

         // frecciaUscitaAttiva = true;

        //}
      //}
      //else if (hSottoMouse == hMiniera)
    //{
     //if (frecciaUscitaAttiva == false)

      //{

        //mouse.SaveCursorUntilItLeaves();

        //mouse.UseModeGraphic(eModeExitRight); 

        //frecciaUscitaAttiva = true;
      //}
    //}
  // --- RESET GENERALE ---

  else

  {

    frecciaUscitaAttiva = false;

  }

}
}

function room_RepExec()

{
  Cambio_Cursore();
}
function room_AfterFadeIn()
{
  
StartCutscene(eSkipESCOnly); // Inizia la cutscene (si può saltare con ESC)
  
  player.Walk(275, 142, eBlock, eWalkableAreas); // Fai camminare il pg al centro
  player.Say("Wow, devo dire che questo e' un signor laboratorio");
  player.Say("Vediamo se riesco a trovare qualcosa di utile.");
  
  EndCutscene(); // Fine della cutscene, il giocatore riprende il controllo
}

