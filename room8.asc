// room script file

function room_Load()
{
aLaboratorio.Play(eAudioPriorityHigh, eRepeat);

}

function room_Unload()
{
aLaboratorio.Stop();
}

bool frecciaUscitaAttiva = false;
function on_mouse_click (MouseButton button)
{
  if (button == eMouseLeft)
  {
   
    if (Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hLaboratorioMiniera)
    {
      if (player.ActiveInventory == null)
      {
        ClaimEvent();
        player.Walk(202, 45, eBlock, eWalkableAreas); 
        player.FaceDirection(eDirectionUp);
        if( enigmaLaboratorio == false)
        {
          player.Say("Prima di andare via, devo vedere se c'e' ancora qualcosa di utile qui");
          player.Walk(player.x, player.y + 20, eBlock, eWalkableAreas);
          player.FaceDirection(eDirectionUp);
        }
        else 
        {       
          player.ChangeRoom(7, 528, 98, eDirectionDown); 
        }
      }
    }
  }
}

function Cambio_Cursore()

{

  if (GUI.GetAtScreenXY(mouse.x, mouse.y) != null || IsGamePaused()) 
  {
    frecciaUscitaAttiva = false; 
    return; 
  }
  Hotspot* hSottoMouse = Hotspot.GetAtScreenXY(mouse.x, mouse.y);
  if (hSottoMouse == hLaboratorioMiniera) 

  {
    if (frecciaUscitaAttiva == false)
    {
      mouse.SaveCursorUntilItLeaves();
      mouse.UseModeGraphic(eModeExitUp);
      frecciaUscitaAttiva = true;
    }

  //}

      //else if (hSottoMouse == hMinieraLaboratorio) 

      //{ 

        //if (frecciaUscitaAttiva == false)

        //{

          //mouse.SaveCursorUntilItLeaves();

          //mouse.UseModeGraphic(eModeExitUp);

         // frecciaUscitaAttiva = true;

        //}
      //}
      //else if (hSottoMouse == hMiniera)
    //{
     //if (frecciaUscitaAttiva == false)

      //{

        //mouse.SaveCursorUntilItLeaves();

        //mouse.UseModeGraphic(eModeExitRight); 

        //frecciaUscitaAttiva = true;
      //}
    //}
  // --- RESET GENERALE ---

  else

  {

    frecciaUscitaAttiva = false;

  }

}
}

function room_RepExec()

{
  Cambio_Cursore();
}
function room_AfterFadeIn()
{
  
StartCutscene(eSkipESCOnly); 
  
  player.Walk(275, 142, eBlock, eWalkableAreas); 
  player.Say("Wow, devo dire che questo e' un signor laboratorio");
  player.Say("Vediamo se riesco a trovare qualcosa di utile.");
  
  EndCutscene(); 
}

