function hComputer_Look(Hotspot *theHotspot, CursorMode mode)
{
  player.Walk(186, 117, eBlock, eWalkableAreas); 
player.FaceDirection(eDirectionLeft);
player.Say("Un vecchio computer, ancora funzionante.");

}



function hComputer_Interact(Hotspot *theHotspot, CursorMode mode)
{
 if(BancoInteragito == true && VasoInteragito == true && TrasformatoreInteragito == true)
 {
   
// 1. INIZIA LA SCENA (il giocatore non può cliccare nulla)
  StartCutscene(eSkipESCOnly);
  
  // 2. IL PROTAGONISTA LEGGE I DATI
  player.Walk(182, 116, eBlock, eWalkableAreas); // Si avvicina al computer
  player.FaceDirection(eDirectionUp);
  player.Say("Vediamo cosa c'è nei file di questo terminale...");
  Wait(40); // Piccola pausa drammatica
  player.Say("Incredibile... Il pianeta è andato in rovina a causa di un sovraccarico dei cristalli.");
  player.Say("Devo sbrigarmi a disattivare il nucleo centrale.");
  
  // 3. ENTRA IL NUOVO PERSONAGGIO
  // Teletrasportiamo il nuovo PNG (es. Guardia) proprio sull'uscio della porta (sostituisci 7 con il numero della tua stanza, X e Y con le coordinate della porta)
  cBecca.ChangeRoom(8, 202, 45); 
  
  // Lo facciamo entrare nella stanza
  cBecca.Walk(182, 116, eBlock, eWalkableAreas); 
  cBecca.FaceCharacter(player); // Guarda verso il protagonista
  
  cBecca.Say("Ehi tu! Che ci fai qui dentro?");
  cBecca.Say("Nessun esploratore è autorizzato ad accedere a questi dati!");
  
  player.FaceCharacter(cBecca, eBlock);
  player.Say("Ehm... posso spiegare, stavo solo...");
  
  // 4. IL TRAVESTIMENTO CEDE (Colpo di scena!)
  player.Say("Oh no... le mie vibrazioni cerebrali... il travestimento non regge più!");
  
  // Riproduci un suono di trasformazione se lo hai
  // aTrasformazione.Play(); 
  
  // Effetto visivo: facciamo un rapido "glitch" o un piccolo sfarfallio
  player.Transparency = 50;
  Wait(10);
  player.Transparency = 0;
  Wait(10);
  
  // LA VERA TRASFORMAZIONE:
  // Sostituisci "HT" con il numero o il nome della VIEW originale del tuo alieno
  player.ChangeView(HARRISON_TORRICES); 
  

  
  // 5. LA REAZIONE DELLA GUARDIA
  cBecca.Say("COSA?! UN MUTAFORMA?!");
  cBecca.Say("Allarme! Abbiamo un intruso alieno nel settore!");
  
  // 6. FINE DELLA SCENA
  EndCutscene();
  
  // 7. INIZIO DEL DIALOGO (OPZIONALE)
  // Subito dopo la cutscene, puoi far partire un dialogo a scelta multipla
  // dConfrontoGuardia.Start();   
   

 }
 else
 {
   
 player.Walk(182, 116, eBlock, eWalkableAreas); 
player.FaceDirection(eDirectionLeft);
 player.Say("Dovrei esplorare meglio il laboratorio prima di estrapolare dati da questo carrettone");
 }
}

function hVasoConservazione_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if(Game.DoOnceOnly("Prima interazione con la teca"))
  {
player.Walk(242, 116, eBlock, eWalkableAreas); 
player.FaceDirection(eDirectionUp);
player.Say("Questa sembrerebbe essere una leva...vediamo cosa fa");
aLeva.Play();
player.Say("Si e' aperto uno spiraglio");
Wait(80);
aTosse.Play();
player.Say("Per l'alto consiglio...che puzza");
player.Say("Fammi chiudere immediatamente");
VasoInteragito = true;
  }
  else
    {
      player.Say("Meglio stare alla larga");
    }

}

function hBancoAlchimia_Interact(Hotspot *theHotspot, CursorMode mode)
{
 if(Game.DoOnceOnly("Prima interazione col banco"))
 {
player.Walk(209, 151, eBlock, eWalkableAreas); 
player.FaceDirection(eDirectionUp);
player.Say("Vediamo un po' cosa c'e' qui...");
aRovistareBanco.Play();
Wait(80);
aBicchiereRotto.Play();
player.Say("ops...");
player.Say("Mh...questo contenitore vuoto potrebbe essere utile...e' della stessa grandezza della cella di raffreddamento della navicella");
player.AddInventory(iCapsulaVuota);
BancoInteragito = true;
 }
 else
   player.Say("Non c'e' piu' nulla di utile");
}

function hVecchioTrasformatore_Interact(Hotspot *theHotspot, CursorMode mode)
{
player.Walk(259, 127, eBlock, eWalkableAreas); 
player.FaceDirection(eDirectionUp);
aTrasformatore.Play();
Wait(160);
player.Say("Non mostra segni di vita");
TrasformatoreInteragito = true;
}
