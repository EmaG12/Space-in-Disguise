// room script file

function oFungo_PickUp(Object *theObject, CursorMode mode)
{
  player.Walk(313, 105,   eBlock, eWalkableAreas);
  player.FaceDirection(eDirectionUp);
  oFungo.Visible = false;
  player.AddInventory(iFungo);
}



