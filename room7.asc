// room script file

function oFungo_PickUp(Object *theObject, CursorMode mode)
{
  player.Walk(313, 105,   eBlock, eWalkableAreas);
  player.FaceDirection(eDirectionUp);
  oFungo.Visible = false;
  player.AddInventory(iFungo);
}



bool frecciaUscitaAttiva = false;


function on_mouse_click (MouseButton button)

{

  if (button == eMouseLeft)
  {
    if (Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hVillaggio_Miniera)
    {
      if (player.ActiveInventory == null)

      {

        ClaimEvent();

        player.Walk(84, 117, eBlock, eWalkableAreas); 
        Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
        player.FaceDirection(eDirectionLeft);
        player.ChangeRoom(4, 1288, 415, eDirectionLeft); 

 

      }

    }

        else if (Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hMinieraLaboratorio)

        {

          if (player.ActiveInventory == null)

          {

            ClaimEvent(); // Blocca l'apertura della ruota


        //Converte il click in un semplice comando di camminata, 

        // in modo che il personaggio raggiunga l'area/region che innesca il cambio stanza

            Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
            player.FaceDirection(eDirectionUp);
            player.Walk(526, 92,  eBlock, eWalkableAreas);
            player.ChangeRoom(8, 204, 51, eDirectionDown); 


        }  

    }
    //else if (Hotspot.GetAtScreenXY(mouse.x,  mouse.y) == hMiniera)
      //{
        //if (player.ActiveInventory == null)
        //{
          //ClaimEvent(); // Blocca l'apertura della ruota


        //Converte il click in un semplice comando di camminata, 

        // in modo che il personaggio raggiunga l'area/region che innesca il cambio stanza

          //Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
          //player.FaceDirection(eDirectionRight);
          //player.Walk(1294, 413,  eBlock, eWalkableAreas);
          //player.ChangeRoom(7, 105, 132, eDirectionRight); 
        //}
      //}

     //}
  }
}

function Cambio_Cursore()

{

  if (GUI.GetAtScreenXY(mouse.x, mouse.y) != null || IsGamePaused()) 
  {
    frecciaUscitaAttiva = false; 
    return; 

  }

  Hotspot* hSottoMouse = Hotspot.GetAtScreenXY(mouse.x, mouse.y);


  if (hSottoMouse == hVillaggio_Miniera) 
  {

    if (frecciaUscitaAttiva == false)
    {
      mouse.SaveCursorUntilItLeaves();
      mouse.UseModeGraphic(eModeExitLeft);
      frecciaUscitaAttiva = true;
    }
  }
      else if (hSottoMouse == hMinieraLaboratorio) 
      { 
        if (frecciaUscitaAttiva == false)
        {
          mouse.SaveCursorUntilItLeaves();
          mouse.UseModeGraphic(eModeExitUp);
          frecciaUscitaAttiva = true;

        }
      }
      //else if (hSottoMouse == hMiniera)
    //{
     //if (frecciaUscitaAttiva == false)

      //{

        //mouse.SaveCursorUntilItLeaves();

        //mouse.UseModeGraphic(eModeExitRight); 

        //frecciaUscitaAttiva = true;
      //}
    //}
  // --- RESET GENERALE ---

  else

  {

    frecciaUscitaAttiva = false;

  }

}


function room_RepExec()

{
  Cambio_Cursore();
}

function room_AfterFadeIn()
{

aMiniera.Play(eAudioPriorityHigh,  eRepeat);
mouse.Mode = eModeInteract;
}

function room_Unload()
{
  aMiniera.Stop();
}

function room_Load()
{
 oNube.SetView(VNUBE);
 oNube.Animate(0, 10, eRepeat, eNoBlock, eForwards);
 RemoveWalkableArea(2);
 if (QuestMushyCompletata == true)
 {
   RestoreWalkableArea(2);
   region[1].Enabled = false;
 }
}

function region1_WalksOnto(Region *theRegion)
{
  player.Say("Non se ne parla. Quel gas viola sembra altamente tossico.");
  player.Walk(player.x - 20, player.y, eBlock, eAnywhere);
}
