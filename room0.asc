// Sostituisci il numero 0 con l'ID di gAction e il numero 2 con l'ID di gMainMenu se sono diversi
function room_Load() {
    gui[0].Visible = false;              // Spegne la barra delle scritte in alto (gAction)
    gui[11].Visible = true;               // Accende il pannello del menù principale (gMainMenu)
    mouse.UseModeGraphic(eModePointer);  // Forza il mouse a mostrare la freccia classica
}

function room_Leave() {
    gui[11].Visible = false;              // Spegne il menù principale quando esci dalla stanza
    gui[0].Visible = true;               // Riaccende la barra delle scritte per giocare nel deserto
}
