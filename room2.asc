// room script file
bool frecciaUscitaAttiva = false;

function Navicella_Look(Hotspot *theHotspot, CursorMode mode)
{
player.Say("La mia navicella...");
player.Say("Il nucleo di raffreddamento aneutronico e' andato...chissa' se riusciro' a ripartire");
}

function on_mouse_click(MouseButton button)
{
  if (button == eMouseLeft)
  {
   
    if (Hotspot.GetAtScreenXY(mouse.x, mouse.y) == hCaverna)
    {
      
      ClaimEvent(); 
      
      
      Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
    }
  }
}

function region1_WalksOnto(Region *theRegion)
{

    mouse.SetPosition(160,  160);
    lblAction.Text = "";
    Wait(1);
    player.ChangeRoom(3, 76, 152);
    player.FaceDirection(eDirectionRight);
}


function Cambio_Cursore()
{
  if (GUI.GetAtScreenXY(mouse.x, mouse.y) != null || IsGamePaused()) 
  {
    frecciaUscitaAttiva = false; 
    return; 
  }

  Hotspot* hSottoMouse = Hotspot.GetAtScreenXY(mouse.x, mouse.y);

  
  if (hSottoMouse == hCaverna) //
  {
    if (frecciaUscitaAttiva == false)
    {
      mouse.SaveCursorUntilItLeaves();
      mouse.UseModeGraphic(eModeExitRight);
      frecciaUscitaAttiva = true;
    }
  }
  
  // --- USCITA 2 (Opzionale: es. verso sinistra nella stessa stanza) ---
  // else if (hSottoMouse == hUscita_Deserto) 
  // {
  //   if (frecciaUscitaAttiva == false)
  //   {
  //     mouse.SaveCursorUntilItLeaves();
  //     mouse.UseModeGraphic(eModeExitLeft); 
  //     frecciaUscitaAttiva = true;
  //   }
  // }
  
  // --- RESET GENERALE ---
  else
  {
    frecciaUscitaAttiva = false;
  }
}

function Navicella_PickUp(Hotspot *theHotspot, CursorMode mode)
{
    if (player.HasInventory(iAllarme) || QuestEsploratoreCompletata == true)
    {
        player.Say("Ho gia' preso quello che mi serve.");
    }
    else if (QuestEsploratore == true)
    {
        player.Walk(135,  148, eBlock);
        player.FaceDirection(eDirectionUp);
        gMinigioco.Visible = true;
    }
    else 
    {
        player.Say("Non penso proprio che mi entrerebbe una navicella intera nello zaino.");
    }
}



function Navicella_Talk(Hotspot *theHotspot, CursorMode mode)
{
player.Say("Ciao, come stai?... Ha visto giorni migliori, probabilmente anche io...");
}

function Navicella_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iCapsulaPiena) 
  {
    player.ActiveInventory = null;
    mouse.Mode = eModePointer; 
    player.LoseInventory(iCapsulaPiena); 
    player.Say("Fatto! Il nucleo e' inserito nel reattore.");
    player.Say("Ricalibro i cavi 0G e ci siamo!");
    player.Say("Questo nucleo e' perfetto, sembra proprio fatto apposta.");
    player.ChangeRoom(9,  0,  0); 
  }
  else
  {
    player.Say("Questo non mi aiutera' a far ripartire la nave.");
  }
}

function room_AfterFadeIn()
{
  aAudioRoom2.Play(eAudioPriorityNormal, eRepeat);
 if(Game.DoOnceOnly("Primo schianto"))
  {
  player.Say("Diamine che botta!");
  player.Say("Ho un dolore al didietro.");
  player.Say("La mia muta rileva ossigeno!");
    player.Say("Ottimo, 21 percento di ossigeno nell'atmosfera...questo pianeta ospitera' sicuramente qualche forma di vita primitiva. Spero non mi sbrani.");
  }
}

function room_Unload()
{
  aAudioRoom2.Stop();
}

function room_RepExec()
{
  Cambio_Cursore();
}

function hPianta_Look(Hotspot *theHotspot, CursorMode mode)
{
player.Walk(210, 170, eBlock, eWalkableAreas);
player.FaceDirection(eDirectionRight);
player.Say("Incredibile...il mio scanner rileva una struttura a tripla elica destra");

}

function hGas_Look(Hotspot *theHotspot, CursorMode mode)
{
player.Walk(57, 128, eBlock, eWalkableAreas);
player.FaceDirection(eDirectionUp);
player.Say("Sembra il gigante gassoso in orbita alla stella 'Alpha Centauri A'");
}
