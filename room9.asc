// room script file

function room_AfterFadeIn()
{

// INIZIA LA CUTSCENE FINALE
  StartCutscene(eSkipESCOnly);
  
   player.Say("Sequenza di decollo avviata. Sistemi al 100%.");
  AudioChannel *canaleJet = aJetOn.Play(); 
  if (canaleJet != null) 
  {
    canaleJet.Volume = 50; 
    Wait(120); 
    int volumeAttuale = 100;
    while (volumeAttuale > 0) 
    {
      volumeAttuale = volumeAttuale - 1; 
      canaleJet.Volume = volumeAttuale;
      Wait(1); 
    }
    canaleJet.Stop(); 
  }
  
  player.Say("Tra pochi minuti sarò finalmente fuori dall'orbita.");
  Wait(60); 
  
  player.Say("...");
  player.Say("...");
  player.Say("Sto scappando. Di nuovo.");
  
  Wait(40);
  aSci_Fi_6_Loop.Play(eAudioPriorityHigh);
  player.Say("Questo pianeta e' distrutto per lo stesso disastro che ha condannato il mio mondo.");
  player.Say("E io sto per fare esattamente cio' che ho fatto a casa: voltare le spalle e fuggire come un vigliacco.");
  
  Wait(30);
 
  player.Say("Computer... annulla la sequenza di decollo.");
  AudioChannel *canaleSpegnimento = aJetOff.Play(); 
  if (canaleSpegnimento != null) 
  {
    canaleSpegnimento.Volume = 50; 
    Wait(40); 
  
    int volumeSpegnimento = 100;
    while (volumeSpegnimento > 0) 
    {
      volumeSpegnimento = volumeSpegnimento - 1; 
      canaleSpegnimento.Volume = volumeSpegnimento;
      Wait(1); 
    }
    canaleSpegnimento.Stop(); 
  }
  player.Say("Non fuggiro' questa volta.");
  player.Say("I dati che ho estrapolato da quel laboratorio sono quasi completi.");
  player.Say("Se unisco queste conoscenze con la tecnologia della popolazione locale...forse c'e' ancora speranza per loro.");
  player.Say("Aiutero' questi primitivi a fermare questo disastro prima che sia irreversibile.");
  player.Say("E quando l'avremo fatto... sapro' come salvare anche casa mia.");
  EndCutscene();
  player.ChangeRoom(10,  0,  0);
  
}

function room_Load()
{
 lblAction.Visible = false;
}
